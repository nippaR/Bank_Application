generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  FINANCE
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  STUDENT
  UNEMPLOYED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGE_REQUESTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String     @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  creditCardApplications   CreditCardApplication[]
  creditCardChangeRequests CreditCardApplicationChangeRequest[]
}

model CreditCardApplication {
  id                 String            @id @default(cuid())
  customerId         String
  fullName           String
  dateOfBirth        DateTime
  nicPassportNumber  String
  residentialAddress String
  mobilePhone        String
  email              String
  employmentStatus   EmploymentStatus
  employerName       String
  monthlyIncome      Decimal           @db.Decimal(12, 2)
  city               String
  postalCode         String
  status             ApplicationStatus @default(PENDING)
  rejectionReason    String?
  submittedAt        DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  customer       User                                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  changeRequests CreditCardApplicationChangeRequest[]
}

model CreditCardApplicationChangeRequest {
  id            String @id @default(cuid())
  applicationId String
  customerId    String

  fullName           String
  dateOfBirth        DateTime
  nicPassportNumber  String
  residentialAddress String
  mobilePhone        String
  email              String
  employmentStatus   EmploymentStatus
  employerName       String
  monthlyIncome      Decimal          @db.Decimal(12, 2)
  city               String
  postalCode         String

  status          ChangeRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  application CreditCardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customer    User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
